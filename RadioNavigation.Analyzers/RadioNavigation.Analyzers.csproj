<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>RadioNavigation.Analyzers</RootNamespace>
    <AssemblyName>RadioNavigation.Analyzers</AssemblyName>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <!-- Analyzers must not be packaged as a normal lib; suppress default items noise -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>RS2008;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" PrivateAssets="all" />
    <PackageReference Include="System.Reflection.Metadata" Version="8.0.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
