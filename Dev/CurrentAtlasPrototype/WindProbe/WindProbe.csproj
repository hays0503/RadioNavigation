<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>7.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <GameSourceRoot Condition="'$(GameSourceRoot)' == ''">C:\code\projects\uboat</GameSourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(GameSourceRoot)/Perlin.cs" Link="LocalGamePerlin.cs" />
  </ItemGroup>
  <Target Name="RequireLocalPerlin" BeforeTargets="CoreCompile" Condition="!Exists('$(GameSourceRoot)/Perlin.cs')">
    <Error Text="Set GameSourceRoot to the local decompiled UBOAT source directory (Perlin.cs). No game source is shipped." />
  </Target>
</Project>
